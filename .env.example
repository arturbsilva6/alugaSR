# Exemplo FICTÍCIO. NUNCA versionar .env real ou credenciais.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Banco local de desenvolvimento; substitua o valor em .env privado.
DATABASE_URL=postgresql://alugasr_dev:senha-ficticia@127.0.0.1:5432/alugasr_dev
# Banco SEPARADO para testes de integração (nunca o mesmo do desenvolvimento).
TEST_DATABASE_URL=postgresql://alugasr_dev:senha-ficticia@127.0.0.1:5432/alugasr_test
# Segredo de sessão/CSRF (>= 32 caracteres). Gere um valor aleatório local, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-local-de-32-ou-mais
# Origens permitidas para mutações (Origin/Referer). Em dev, padrão = 127.0.0.1/localhost:PORT.
# APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# COOKIE_SECURE=false   # true obrigatório em produção (HTTPS)
# SESSION_ABSOLUTE_MINUTES=480
# SESSION_IDLE_MINUTES=30
# Armazenamento LOCAL de fotos (somente desenvolvimento). Produção: PENDENTE (DEC-011/EXT-05).
STORAGE_LOCAL_DIR=.storage
# UPLOAD_MAX_BYTES=5242880
# UPLOAD_MAX_PHOTOS=10
# Rótulo de demonstração: todos os anúncios exibidos são sintéticos.
DEMO_MODE=true
# Senha FICTÍCIA das contas sintéticas criadas por `npm run db:seed` (somente local).
# SEED_DEMO_PASSWORD=AlugaSR-demo-2026
# Recursos pós-MVP: desligados por padrão; proibidos em produção até aprovação externa.
# FEATURE_PUBLIC_REGISTRATION=false
# FEATURE_FAVORITES=false
# FEATURE_CHAT=false
# FEATURE_REVIEWS=false
# FEATURE_POPULAR_SORT=false
